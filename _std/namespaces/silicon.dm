ADD_TO_NAMESPACE(SILICON, LAWS, SET)(var/const/ASIMOV = "Asimov Laws (Default)")
ADD_TO_NAMESPACE(SILICON, LAWS, SET)(var/const/ROBOCOP = "Robocop Laws")
ADD_TO_NAMESPACE(SILICON, LAWS, SET)(var/const/CORPORATE = "Corporate Laws")
ADD_TO_NAMESPACE(SILICON, LAWS, SET)(var/const/SYNDICATE = "Syndicate Laws")

// Law interact menu actions
CREATE_NAMESPACE(SILICON, LAWS, ACTION)
ADD_TO_NAMESPACE(SILICON, LAWS, ACTION)(var/const/VIEW = "View")
ADD_TO_NAMESPACE(SILICON, LAWS, ACTION)(var/const/STATE = "State")
ADD_TO_NAMESPACE(SILICON, LAWS, ACTION)(var/const/EDIT = "Edit")

// Cyborg-specific
CREATE_NAMESPACE(SILICON, CYBORG)

// cyborg customization menu options
CREATE_NAMESPACE(SILICON, CYBORG, CUSTOMIZE)
ADD_TO_NAMESPACE(SILICON, CYBORG, CUSTOMIZE)(var/const/FACEPLATE = "Change Faceplate")
ADD_TO_NAMESPACE(SILICON, CYBORG, CUSTOMIZE)(var/const/DISPLAY = "Background Mode")
ADD_TO_NAMESPACE(SILICON, CYBORG, CUSTOMIZE)(var/const/SCREAM = "Scream Note")
ADD_TO_NAMESPACE(SILICON, CYBORG, CUSTOMIZE)(var/const/PITCH = "Vocal Pitch")
ADD_TO_NAMESPACE(SILICON, CYBORG, CUSTOMIZE)(var/const/MONOSPACE = "Monospace Toggle")

// AI-specific
CREATE_NAMESPACE(SILICON, AI)

// AI mainframe dismantling stages
CREATE_NAMESPACE(SILICON, AI, DISMANTLE_STAGE)
ADD_TO_NAMESPACE(SILICON, AI, DISMANTLE_STAGE)(var/const/LOCKED = 0)
