CREATE_NAMESPACE(SILICON)

// Laws and law interactions
CREATE_NAMESPACE(SILICON, LAWS)

// Auto-state law delays
CREATE_NAMESPACE(SILICON, LAWS, DELAY)
ADD_TO_NAMESPACE(SILICON, LAWS, DELAY)(var/const/STATE_LAWS = 20 SECONDS)
ADD_TO_NAMESPACE(SILICON, LAWS, DELAY)(var/const/PER_LAW = 1 SECOND)

// Premade lawsets
CREATE_NAMESPACE(SILICON, LAWS, SET)
ADD_TO_NAMESPACE(SILICON, LAWS, SET)(var/const/REAL = "Real Laws (Current)")
