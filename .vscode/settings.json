{
	"eslint.nodePath": "./tgui/.yarn/sdks",
	"eslint.workingDirectories": [
		"./tgui",
		"./browserassets/src"
	],
	"prettier.prettierPath": "./tgui/.yarn/sdks/prettier/index.cjs",
	"typescript.tsdk": "./tgui/.yarn/sdks/typescript/lib",
	"typescript.enablePromptUseWorkspaceTsdk": true,
	"search.exclude": {
		"**/.yarn": true,
		"**/.pnp.*": true,
	},
	"editor.codeActionsOnSave": {
		"source.fixAll.eslint": "explicit"
	},
	"scm.showHistoryGraph": false,
	"[javascript]": {
		"editor.rulers": [
			80
		],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[javascriptreact]": {
		"editor.rulers": [
			80
		],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[typescript]": {
		"editor.rulers": [
			80
		],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[typescriptreact]": {
		"editor.rulers": [
			80
		],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[scss]": {
		"editor.rulers": [
			80
		],
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[dm]": {
		"editor.rulers": [
			150
		]
	},
	// Ignore whitespace for blame
	"gitlens.advanced.blame.customArguments": [
		"-w"
	],
	"workbench.editorAssociations": {
		"*.dmi": "dmiEditor.dmiEditor"
	},
	"diffEditor.codeLens": true,
	"errorLens.enabledDiagnosticLevels": [
		"error",
		"warning",
		"info"
	],
	"tgstationTestExplorer.project.DMEName": "goonstation.dme",
	"tgstationTestExplorer.project.defines": [
		"#define UNIT_TESTS"
	],
	"prettier.configPath": "",
	"ss13BuildFlags.configPath": "tools/build_flags.json",
	"ss13BuildFlags.baseTask": "dm: build - goonstation.dme",
	"ss13BuildFlags.injectionMode": "write-file",
	"ss13BuildFlags.localDefinesPath": "_std/__build.local.dm",
	"ss13BuildFlags.definesDocPath": "_std/__build.dm"
}
